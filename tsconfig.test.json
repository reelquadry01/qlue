{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "emitDeclarationOnly": false,
    "incremental": false,
    "module": "commonjs",
    "moduleResolution": "node",
    "target": "es2022",
    "jsx": "react-jsx",
    "outDir": ".verify",
    "rootDir": "."
  },
  "include": ["tests/**/*.ts", "src/engine/**/*.ts", "src/lib/routes.ts", "src/lib/preferences.ts"],
  "exclude": ["node_modules", ".next", "out"]
}